{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "es6",
        "target": "es6",
        "allowJs": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "typeRoots": [
            "./node_modules/@webgpu/types",
            "./node_modules/@types"
        ],
        "lib": [
            "dom",
            "es5",
            "scripthost",
            "es2015.promise",
            "es2020"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "tests",
        "scratch"
    ]
}